# ===== Kora — Tuteur IA (AI Gateway) =====
# Désactive/active la chaîne multi-provider (Groq → HuggingFace → Cloudflare → Cerebras → Gemini → OpenAI).
# Par défaut : activée automatiquement dès qu'une clé Groq/HF/Cloudflare est présente.
AI_GATEWAY_ENABLED=true
# Provider prioritaire parmi : groq | huggingface | cloudflare | cerebras | gemini | openrouter | openai
AI_PRIMARY_PROVIDER=groq
# Groq (principal)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Hugging Face (fallback 1) — clé d'accès https://huggingface.co/settings/tokens
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Cloudflare Workers AI (fallback 2)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Cerebras (fallback 3) — gratuit, rapide, pas de CB requise → https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.1-8b
# Rate limiting IA (nombre de requêtes LLM)
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_DAILY_REQUESTS=100
# Embeddings pour le RAG (gemini par défaut si clé présente, sinon huggingface)
AI_EMBEDDING_PROVIDER=gemini
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Legacy (utilisés comme fallbacks et en mode sans gateway)
GEMINI_API_KEY=
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-4o-mini

# ===== Base de données =====
# URL Neon (préfixe "postgresql://" avec ?sslmode=require).
# Utiliser la chaîne POOLÉE (host ...-pooler) pour le serverless Vercel.
# Si vide -> mode SQLite local ; si définie -> mode Postgres (IS_PG=true).
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/edukora?sslmode=require
# Passe à "true" pour désactiver TLS (bases non Neon, local uniquement)
DATABASE_SSL_DISABLED=false

# ===== Comptes & sécurité =====
# Compte administrateur (bootstrap automatique au premier démarrage)
ADMIN_EMAIL=admin@test.ci
ADMIN_PASSWORD=admin123
# Secret de signature des sessions (obligatoire en production, 32 chars minimum)
SESSION_SECRET=change-me-please
# Secret partagé pour déclencher les routes /api/cron/* et /api/warmup
# (en-tête "authorization: Bearer <CRON_SECRET>") — cf. vercel.json
CRON_SECRET=change-me-too

# ===== Paiement Premium (GeniusPay) =====
# Clé API marchand (format gp_test_... ou gp_live_...)
GENIUSPAY_API_KEY=gp_test_...
# Secret de signature des requêtes API (merchant API secret, fourni par GeniusPay)
GENIUSPAY_API_SECRET=gp_secret_...
# Secret du webhook (format whsec_test_... ou whsec_live_...)
GENIUSPAY_WEBHOOK_SECRET=whsec_test_...
# Base API (sandbox: https://pay.genius.ci/api/v1/merchant)
GENIUSPAY_API_BASE=https://pay.genius.ci/api/v1/merchant
# Indicatif pays par défaut (CI = 225)
GENIUSPAY_COUNTRY_CODE=225
# URL publique de l'application (liens d'abandon de checkout, réinitialisation de mot de passe)
NEXT_PUBLIC_APP_URL=https://edukora.net

# ===== E-mails (Brevo OU SMTP) =====
# Canal Brevo (API v3) — prioritaire si MAIL_USE_BREVO=1 ou si SMTP absent
BREVO_API_KEY=
# Force le passage par l'API Brevo même si SMTP est configuré ("1" ou absent)
MAIL_USE_BREVO=1
# Expéditeur (défaut: support@edukora.net)
MAIL_FROM_EMAIL=support@edukora.net
# Canal SMTP (utilisé si SMTP_USER/PASS définis et MAIL_USE_BREVO absent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===== WhatsApp (Evolution API — rapports & relances) =====
# URL du serveur Evolution, ex: https://evolution1.monserveur.ci
WHATSAPP_API_URL=
# Identifiant de l'instance Evolution
WHATSAPP_INSTANCE=
# Clé API de l'instance (Evolution "apikey")
WHATSAPP_API_KEY=
# Groupe/numéro recevant le rapport quotidien (ex: 2250700000000)
WHATSAPP_REPORT_GROUP=

# ===== VAPID Push Notifications =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== Analytics (Google Analytics + Microsoft Clarity) =====
# Mesurement ID GA4, ex: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# API Secret GA4 (Settings > Data Streams > Measurement Protocol API secrets) — événements SSR (rapports, relances)
GA4_API_SECRET=
# Microsoft Clarity (Project ID)
NEXT_PUBLIC_CLARITY_ID=

# ===== Publicités Google AdSense =====
# Publisher ID AdSense (format ca-pub-XXXXXXXXXXXXXXXX) — obtenu après approbation du compte
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-6284863336676978

# ===== SEO =====
# Jeton de vérification Google Search Console (meta "google-site-verification") — optionnel
GSC_VERIFICATION=

# ===== A/B test tarifs (Prop A/B) =====
# "off" désactive l'A/B (toujours variante A) ; tout autre valeur (ex: "on") l'active (50/50)
AB_PRICING=on

# ===== Divers =====
# Désactive le rate-limiter applicatif (uniquement pour les tests e2e locaux)
RATE_LIMIT_DISABLED=0
# URL utilisée par /api/warmup pour réchauffer les pages (sinon détecté via VERCEL_PROJECT_PRODUCTION_URL)
WARMUP_ORIGIN=https://edukora.net
# Base URL cible des tests e2e QA (scripts/qa-e2e)
QA_BASE_URL=https://edukora.net

# ===== Sentry (Error Monitoring) =====
# DSN serveur/edge (visible dans Settings > Client Keys du projet Sentry)
SENTRY_DSN=https://public@o<orgId>.ingest.sentry.io/<projectId>
# DSN client/navigateur (public — préfixe NEXT_PUBLIC obligatoire)
NEXT_PUBLIC_SENTRY_DSN=https://public@o<orgId>.ingest.sentry.io/<projectId>
# Upload des source maps au build (Settings > Auth Tokens > Create New Token, scope "project:releases" + "org:read")
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token
# Tag de release (ex: commit SHA) — sinon le SDK détecte automatiquement depuis le git/Vercel
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# ===== Comptes de test (dev uniquement) =====
TEST_ACCOUNT_PASSWORD=ChangeMe!123

# ===== Growth AI (marketing automation) =====
# Utilise le gateway principal (aucune clé supplémentaire requise).
ADMIN_API_KEY=change-me-admin