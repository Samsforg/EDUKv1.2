# ===== Kora — Tuteur IA =====
GEMINI_API_KEY=
GEMINI_TUTOR_MODEL=gemini-3.1-flash-lite

# ===== VAPID Push Notifications =====
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ===== Analytics =====
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=edukora.ci

# ===== Vercel (optional) =====
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# ===== Neon PostgreSQL (production) =====
# URL de connexion Neon (préfixe "postgresql://" avec ?sslmode=require).
# Utiliser la chaîne POOLÉE (host ...-pooler) pour le serverless Vercel.
# Si vide -> mode SQLite local ; si définie -> mode Postgres (IS_PG=true).
DATABASE_URL=postgresql://user:password@host-pooler.neon.tech/edukora?sslmode=require
# Compte administrateur (bootstrap automatique)
ADMIN_EMAIL=admin@test.ci
ADMIN_PASSWORD=admin123
# Secret de signature des sessions (obligatoire en production)
SESSION_SECRET=change-me-please

# Paiement Premium (GeniusPay)
# Clé API marchand (format gp_test_... ou gp_live_...)
GENIUSPAY_API_KEY=gp_test_...
# Secret du webhook (format whsec_test_... ou whsec_live_...)
GENIUSPAY_WEBHOOK_SECRET=whsec_test_...
# Base API (sandbox: https://pay.genius.ci/api/v1/merchant)
GENIUSPAY_API_BASE=https://pay.genius.ci/api/v1/merchant
# Indicatif pays par défaut (CI = 225)
GENIUSPAY_COUNTRY_CODE=225
NEXT_PUBLIC_APP_URL=https://edu-kv1-2.vercel.app

# ===== Sentry (Error Monitoring) =====
# DSN serveur/edge (visible dans Settings > Client Keys du projet Sentry)
SENTRY_DSN=https://public@o<orgId>.ingest.sentry.io/<projectId>
# DSN client/navigateur (public — préfixe NEXT_PUBLIC obligatoire)
NEXT_PUBLIC_SENTRY_DSN=https://public@o<orgId>.ingest.sentry.io/<projectId>
# Upload des source maps au build (Settings > Auth Tokens > Create New Token, scope "project:releases" + "org:read")
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-auth-token
# Tag de release (ex: commit SHA) — sinon le SDK détecte automatiquement depuis le git/Vercel
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=
