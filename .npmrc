# Strict dependency integrity
package-lock=true
package-lock-only=false
save-exact=true
legacy-peer-deps=false
audit-level=moderate
fund=false
prefer-offline=false

# Script security
# install scripts run (ignore-scripts=false) ; the per-package policy lives
# in package.json "allowScripts". Removed non-npm keys that only produced
# "Unknown project config" warnings: strict-peer-dependencies,
# verify-store-integrity (not npm options; npm already verifies integrity
# via lockfile hashes and errors on peer conflicts by default).
ignore-scripts=false

# Network
registry=https://registry.npmjs.org/
prefer-online=true